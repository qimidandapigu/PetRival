# Node 24+, single-process local prototype. Keep the real key in ignored .env only.
HOST=127.0.0.1
PORT=4388
AI_MODE=model
MODEL_CHAT_URL=https://api.deepseek.com/chat/completions
MODEL_NAME=deepseek-v4-pro
MODEL_API_KEY=configure-locally-never-commit
# DeepSeek uses thinking enabled / high effort and max_tokens=16384.
# Preparation requests allow 240 seconds; gameplay has a total 180-second clock.
# No model calls in AI_MODE=algorithm. Other compatible chat endpoints remain supported.
# MODEL_TOKEN_PARAMETER=max_tokens
# For providers requiring it, use max_completion_tokens instead.
# DATA_DIR=./data
# Optional phone login on the Sites Worker; enable built-in SMS in Shanghai first.
# CLOUDBASE_ENV_ID=your-cloudbase-environment-id
