# Node 24+, single-process local prototype. No model calls in algorithm mode.
HOST=127.0.0.1
PORT=4388
AI_MODE=algorithm
# For a server-side compatible chat provider, set all four values explicitly.
# AI_MODE=model
# MODEL_CHAT_URL=https://your-provider.example/v1/chat/completions
# MODEL_NAME=your-model-name
# MODEL_API_KEY=configure-locally-never-commit
# MODEL_TOKEN_PARAMETER=max_tokens
# For providers requiring it, use max_completion_tokens instead.
# DATA_DIR=./data
